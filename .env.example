# Copia questo file come "config/dev.env" o ".env" e inserisci i valori reali.
# I file con segreti reali NON vanno su GitHub (esclusi da .gitignore).

# --- Database PostgreSQL ---
POSTGRES_USER=lab
POSTGRES_PASSWORD=cambia_questa_password
POSTGRES_DB=segnalazioni

# --- Collegamento del backend al database ---
DB_HOST=db
DB_PORT=5432

# --- Configurazione Server, Rete e Log ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info