# Copia questo file come ".env" (stessa cartella) e, se vuoi, cambia i valori.
# Il file .env NON va su GitHub (e escluso da .gitignore): questo e solo l'esempio.

# --- Database PostgreSQL (usate da Docker per creare il database) ---
POSTGRES_USER=lab
POSTGRES_PASSWORD=cambia_questa_password
POSTGRES_DB=segnalazioni

# --- Collegamento del backend al database ---
DB_HOST=localhost
DB_PORT=5432

# --- Porta su cui ascolta il backend ---
PORT=3000
